# MAIN
# ======================================================================

def main():
    conn, cur = init_db()

    print(f"[INFO] Loading YOLO: {YOLO_MODEL_NAME}...")
    model = YOLO(YOLO_MODEL_NAME)

    print(f"[INFO] Loading JSON & Cams...")
    cameras_config = load_cameras_and_slots(SLOTS_JSON_PATH, override_urls=OVERRIDE_URLS)
    
    if not cameras_config:
        print("ERROR: No camera data.")
        return

    # Start Streams
    readers = []
    for cfg in cameras_config:
        r = StreamReader(cfg["url"], cfg["id"])
        r.start()
        readers.append(r)
        
        # Init State
        cfg["last_slot_taken"] = [False] * len(cfg["slots"])
        cfg["last_occupied_count"] = 0
        cfg["last_boxes"] = []
        cfg["last_points"] = []

    if SHOW:
        cv2.namedWindow("Multi-Camera Parking", cv2.WINDOW_NORMAL)
        cv2.resizeWindow("Multi-Camera Parking", MAX_WIDTH, MAX_HEIGHT)

    frame_idx = 0

    try:
        while True:
            frame_idx += 1
            
            # Reset counter global untuk frame ini
            global_occupied = 0
            global_slots = 0
            
            vis_tiles = [] 
            
            for i, cfg in enumerate(cameras_config):
                reader = readers[i]
                raw_frame = reader.get_frame()
                
                # --- KAMERA MATI ---
                if raw_frame is None:
                    txt = f"CAM {cfg['id']} No Signal"
                    vis_tiles.append(make_placeholder(txt, TILE_W, TILE_H))
                    continue

                # --- KAMERA HIDUP ---
                
                # 1. DETEKSI (Throttled)
                if frame_idx % FRAME_STEP == 0:
                    temp_boxes = []
                    temp_points = []
                    try:
                        res = model.predict(raw_frame, conf=CONF_THRESHOLD, verbose=False, classes=VEHICLE_CLASSES)
                        for r in res:
                            for box in r.boxes:
                                x1, y1, x2, y2 = box.xyxy[0].cpu().numpy()
                                
                                # Titik jangkar (Kaki kendaraan)
                                cx = int((x1 + x2) / 2)
                                h_box = y2 - y1
                                cy = int(y1 + (h_box * 0.75))
                                
                                temp_boxes.append((int(x1), int(y1), int(x2), int(y2)))
                                temp_points.append((cx, cy))
                    except Exception as e:
                        print(f"Err Detect Cam {cfg['id']}: {e}")
                    
                    cfg["last_boxes"] = temp_boxes
                    cfg["last_points"] = temp_points
                    
                    # Cek Overlap Slot
                    current_slot_taken = []
                    for s in cfg["slots"]:
                        is_occ = False
                        for pt in temp_points:
                            if check_overlap(s["points"], pt):
                                is_occ = True
                                break
                        current_slot_taken.append(is_occ)
                    
                    cfg["last_slot_taken"] = current_slot_taken
                    cfg["last_occupied_count"] = sum(current_slot_taken)

                # 2. AKUMULASI STATISTIK
                global_occupied += cfg["last_occupied_count"]
                global_slots += len(cfg["slots"])

                # 3. VISUALISASI FRAME
                vis = raw_frame.copy()
                
                # A. Gambar Slot (Merah/Hijau)
                for idx_s, s in enumerate(cfg["slots"]):
                    color = (0, 0, 255) if cfg["last_slot_taken"][idx_s] else (0, 255, 0)
                    cv2.polylines(vis, [s["points"]], True, color, 2)
                
                # B. Gambar Bounding Box & Titik Kuning (Kendaraan)
                for box, pt in zip(cfg["last_boxes"], cfg["last_points"]):
                    # Kotak Kuning Tipis
                    cv2.rectangle(vis, (box[0], box[1]), (box[2], box[3]), (0, 255, 255), 2)
                    # Titik Kuning Solid (Centroid)
                    cv2.circle(vis, pt, 6, (0, 255, 255), -1)

                # C. Label ID Kamera (Kecil di pojok)
                cv2.rectangle(vis, (0,0), (180, 40), (0,0,0), -1)
                cv2.putText(vis, f"CAM {cfg['id']}", (10,30), 
                           cv2.FONT_HERSHEY_SIMPLEX, 1.0, (255,255,255), 2)

                vis_tiles.append(resize_with_letterbox(vis, TILE_W, TILE_H))

            # --- HITUNG SISA (EMPTY) ---
            global_empty = global_slots - global_occupied

            # --- UPDATE DATABASE (Throttled) ---
            if frame_idx % FRAME_STEP == 0:
                if conn and cur:
                    insert_occupancy(cur, conn, global_occupied, global_empty, global_slots)

            # --- DISPLAY MOSAIC + INFO BAR ---
            if SHOW:
                # Isi placeholder jika kamera < 4
                while len(vis_tiles) < ROWS * COLS:
                    vis_tiles.append(make_placeholder("NO CAM", TILE_W, TILE_H))
                
                # Susun Grid Video
                row1 = np.hstack([vis_tiles[0], vis_tiles[1]])
                row2 = np.hstack([vis_tiles[2], vis_tiles[3]])
                video_grid = np.vstack([row1, row2])
                
                # Buat Info Bar (Dashboard) di Bawah
                info_h = 80 # Tinggi bar informasi
                info_bar = create_info_bar(MAX_WIDTH, info_h, global_slots, global_occupied, global_empty)
                
                # Gabungkan Video + Info Bar
                final_display = np.vstack([video_grid, info_bar])
                
                # Resize agar pas di layar jika perlu (optional, karena window normal)
                cv2.imshow("Multi-Camera Parking", final_display)
                
                if cv2.waitKey(1) & 0xFF == 27: # ESC
                    break

    except KeyboardInterrupt:
        print("[INFO] Stopped.")
    finally:
        for r in readers:
            r.stop()
        cv2.destroyAllWindows()
        if conn:
            cur.close()
            conn.close()
        print("[INFO] Done.")

if __name__ == "__main__":
    main()
