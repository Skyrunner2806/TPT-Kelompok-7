class StreamReader(threading.Thread):
    def __init__(self, url, cam_id):
        super().__init__(daemon=True)
        self.url = url
        self.cam_id = cam_id
        self.cap = None
        self.lock = threading.Lock()
        self.frame = None
        self.ok = False
        self.running = True

    def open(self):
        if self.cap is not None:
            try:
                self.cap.release()
            except:
                pass
        print(f"[INFO] Connecting to CAM {self.cam_id}...")
        self.cap = cv2.VideoCapture(self.url)
        try:
            self.cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)
        except:
            pass
        self.ok = self.cap.isOpened()
        return self.ok

    def run(self):
        while self.running:
            if self.cap is None or not self.ok:
                self.open()
                if not self.ok:
                    time.sleep(2.0)
                    continue
            ret, frm = self.cap.read()
            if not ret or frm is None:
                self.ok = False
                time.sleep(0.5)
                continue
            with self.lock:
                self.frame = frm

    def get_frame(self):
        with self.lock:
            return None if self.frame is None else self.frame.copy()

    def stop(self):
        self.running = False
        if self.cap is not None:
            self.cap.release()

def load_cameras_and_slots(json_path, override_urls=None):
    try:
        with open(json_path, "r") as f:
            data = json.load(f)
    except Exception as e:
        print(f"[ERROR] JSON: {e}")
        return []

    cameras_data = data.get("cameras", [])
    if not cameras_data:
        return []

    parsed_cameras = []
    for i, cam in enumerate(cameras_data):
        cid = cam.get("camera_id", i)
        
        # Override URL Logic
        if override_urls and i < len(override_urls):
            url = override_urls[i]
        else:
            url = cam.get("rtsp_url", "")
            
        slots_raw = cam.get("slots", [])
        slots = []
        for s in slots_raw:
            pts = np.array(s["points"], dtype=np.int32)
            sid = s.get("id", 0)
            M = cv2.moments(pts)
            if M["m00"] != 0:
                cx = int(M["m10"] / M["m00"])
                cy = int(M["m01"] / M["m00"])
            else:
                cx, cy = np.mean(pts, axis=0).astype(int)

            slots.append({"id": sid, "points": pts, "center": (cx, cy)})
        
        parsed_cameras.append({"id": cid, "url": url, "slots": slots})
    return parsed_cameras

def check_overlap(slot_polygon, point):
    return cv2.pointPolygonTest(slot_polygon, point, False) >= 0

def resize_with_letterbox(frame, target_w, target_h):
    h, w = frame.shape[:2]
    scale = min(target_w / w, target_h / h)
    new_w = max(1, int(w * scale))
    new_h = max(1, int(h * scale))
    resized = cv2.resize(frame, (new_w, new_h), interpolation=cv2.INTER_AREA)
    canvas = np.zeros((target_h, target_w, 3), dtype=np.uint8)
    x = (target_w - new_w) // 2
    y = (target_h - new_h) // 2
    canvas[y:y+new_h, x:x+new_w] = resized
    return canvas

def make_placeholder(text, w, h):
    img = np.zeros((h, w, 3), dtype=np.uint8)
    cv2.putText(img, text, (20, h//2), cv2.FONT_HERSHEY_SIMPLEX, 1.0, (0, 0, 255), 2)
    return img

def create_info_bar(width, height, total, occ, empty):
    """Membuat bar informasi statistik global"""
    bar = np.zeros((height, width, 3), dtype=np.uint8)
    # Background abu-abu tua
    bar[:] = (30, 30, 30) 
    
    text = f"TOTAL SPOTS: {total}   |   OCCUPIED: {occ}   |   EMPTY: {empty}"
    
    # Text styles
    font = cv2.FONT_HERSHEY_SIMPLEX
    scale = 1.2
    thickness = 3
    color = (255, 255, 255)
    
    # Center text
    text_size = cv2.getTextSize(text, font, scale, thickness)[0]
    text_x = (width - text_size[0]) // 2
    text_y = (height + text_size[1]) // 2
    
    cv2.putText(bar, text, (text_x, text_y), font, scale, color, thickness)
    return bar

