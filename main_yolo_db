def init_db():
    try:
        conn = psycopg2.connect(**DB_CONFIG)
        cur = conn.cursor()
        cur.execute(f"""
            CREATE TABLE IF NOT EXISTS {DB_TABLE_NAME} (
                id SERIAL PRIMARY KEY,
                ts TIMESTAMPTZ NOT NULL,
                occupied INTEGER,
                empty INTEGER,
                total_slots INTEGER
            );
        """)
        conn.commit()
        print("[INFO] DB Connected.")
        return conn, cur
    except Exception as e:
        print(f"[WARN] DB Connection Failed: {e}")
        return None, None

def insert_occupancy(cur, conn, occupied, empty, total_slots):
    try:
        cur.execute(
            f"INSERT INTO {DB_TABLE_NAME} (ts, occupied, empty, total_slots) VALUES (%s, %s, %s, %s);",
            (datetime.now(), occupied, empty, total_slots)
        )
        conn.commit()
        print(f"[DB SAVED] Total: {total_slots} | Occ: {occupied} | Empty: {empty}")
    except Exception as e:
        print(f"[ERROR] DB Insert: {e}")

